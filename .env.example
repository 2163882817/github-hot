# Server-side GitHub metadata enrichment. Never expose this token to the browser.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/github_hot_report
GITHUB_TOKEN=
OPENAI_TRANSLATION_MODEL=
COLLECTION_INTERVAL_MINUTES=60
ACTIVE_LANGUAGE_HOURS=24
STALE_AFTER_MINUTES=90
UPSTREAM_TIMEOUT_MS=12000
TRANSLATION_TIMEOUT_MS=20000
